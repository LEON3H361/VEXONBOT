@dp.message(UserStates.waiting_for_receipt, F.photo)
async def process_receipt(message: Message, state: FSMContext):
    user_id = message.from_user.id
    username = f"@{message.from_user.username}" if message.from_user.username else "ندارد"
    full_name = message.from_user.full_name
    photo_id = message.photo[-1].file_id

    await state.clear()
    await message.answer("✅ رسید شما با موفقیت ثبت شد و برای ادمین ارسال گردید. پس از تایید، کانفیگ برای شما ارسال می‌شود.")

    admin_markup = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(text="✅ تایید و ارسال کانفیگ", callback_data=f"approve_{user_id}"),
            InlineKeyboardButton(text="❌ رد رسید", callback_data=f"reject_{user_id}")
        ]
    ])

    for admin_id in ADMIN_IDS:
        try:
            await bot.send_photo(
                chat_id=admin_id,
                photo=photo_id,
                caption=f"📥 **رسید جدید دریافت شد!**\n\n👤 کاربر: {full_name} ({username})\n🆔 شناسه عددی: `{user_id}`",
                parse_mode="Markdown",
                reply_markup=admin_markup
            )
        except Exception as e:
            logging.error(f"Error sending receipt to admin {admin_id}: {e}")

