@dp.callback_query(F.data.startswith("approve_"))
async def approve_receipt(callback: CallbackQuery, state: FSMContext):
    target_user_id = int(callback.data.split("_")[1])
    
    await callback.message.edit_caption(
        caption=f"{callback.message.caption}\n\n✅ **این رسید تایید شد.**\nحالا لطفاً متن/لینک کانفیگ را ارسال کنید تا برای کاربر ارسال شود.",
        parse_mode="Markdown"
    )
    
    await state.update_data(target_user=target_user_id)
    await state.set_state(AdminStates.waiting_for_config_to_send)
    await callback.answer()

@dp.message(AdminStates.waiting_for_config_to_send)
async def send_config_to_user(message: Message, state: FSMContext):
    data = await state.get_data()
    target_user_id = data.get("target_user")
    
    config_text = message.text
    
    try:
        await bot.send_message(
            chat_id=target_user_id,
            text=f"🎉 **سفارش شما در vexon تایید شد!**\n\n🔑 کانفیگ شما:\n`{config_text}`",
            parse_mode="Markdown"
        )
        await message.answer(f"✅ کانفیگ با موفقیت برای کاربر `{target_user_id}` ارسال شد.", parse_mode="Markdown")
    except Exception as e:
        await message.answer(f"❌ خطا در ارسال پیام به کاربر: {e}")
    
    await state.clear()

@dp.callback_query(F.data.startswith("reject_"))
async def reject_receipt(callback: CallbackQuery):
    target_user_id = int(callback.data.split("_")[1])
    
    await callback.message.edit_caption(
        caption=f"{callback.message.caption}\n\n❌ **این رسید رد شد.**",
        parse_mode="Markdown"
    )
    
    try:
        await bot.send_message(
            chat_id=target_user_id,
            text="❌ رسید واریزی شما توسط ادمین تایید نشد. در صورت وجود مشکل با پشتیبانی در ارتباط باشید."
        )
    except Exception as e:
        logging.error(f"Error notifying user: {e}")
        
    await callback.answer()

